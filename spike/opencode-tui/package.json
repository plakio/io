{
  "name": "io-spike-opencode-tui",
  "private": true,
  "type": "module",
  "scripts": {
    "patch:ws": "node scripts/patch-node-ws.mjs",
    "start": "node --experimental-ffi spike.mjs",
    "start:bun": "bun spike.mjs",
    "build:bin": "bun build --compile spike.mjs --outfile spike-bin --define 'process.env.OPENTUI_LIBC=\"glibc\"'"
  },
  "dependencies": {
    "@opencode/sdk": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "@opentui/core": "0.9.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330"
  }
}
