{
  "name": "io",
  "version": "0.2.2",
  "description": "A minimal AI coding harness with an embedded OpenCode engine and an OpenTUI interface, built for Plak.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26.4.0"
  },
  "bin": {
    "io": "dist-next/io"
  },
  "scripts": {
    "build": "node scripts/build-next.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=70 test/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "start": "node --experimental-ffi src/cli.ts",
    "test:ui": "node --import tsx --test test/tui-*.test.ts",
    "test:ui:bun": "bun test test/tui-*.test.ts --timeout 20000"
  },
  "dependencies": {
    "@opencode/client": "^2.3.2",
    "@opencode/core": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "@opencode/sdk": "2.3.2",
    "@opentui/core": "0.9.7",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
